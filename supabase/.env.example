# ============================================================================
# MASAR Care — Supabase Edge Function Runtime Secrets Template (No Real Values)
# Set these ONLY via `supabase secrets set` during authorized Stage 2B.2B.
# Never commit real secret values to git or paste them into chat.
# ============================================================================

# Required (>= 32 chars) ONLY during initial one-time bootstrap, then MUST be unset:
MASAR_BOOTSTRAP_TOKEN="replace-with-random-32-plus-char-secret-for-bootstrap-only"
MASAR_PLATFORM_ADMIN_TOKEN="replace-with-independent-32-plus-char-admin-secret"

# Required for `owner-provision-staff` in connected dev/production environments:
# Comma-separated explicit origins (wildcard `*` is rejected by Edge code).
MASAR_CORS_ALLOWED_ORIGINS="https://your-crm-domain.example,http://localhost:3000"
