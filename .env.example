# MASAR Care — Stage 1 Pharmacist CRM Prototype Environment Variables
# Note: Stage 1 runs completely in-memory with fictional data and requires NO API secrets.
# Gemini API is NOT used by this application.

# APP_URL: The URL where this applet is hosted (optional).
APP_URL="MY_APP_URL"

# VITE_DISABLE_DEMO_CLOCK: Optional dev-only switch ("true" hides the Nov 12 fixture toggle in `vite dev`).
# Production builds (`import.meta.env.DEV === false`) ALWAYS run on Live Asia/Baghdad time and
# ignore any demo-clock override flags so clinical deployments cannot lock to a fixture date.
VITE_DISABLE_DEMO_CLOCK="false"

# ============================================================================
# STAGE 2B SUPABASE CONFIGURATION (Option B: Shared Project + Strict RLS)
# ============================================================================
# VITE_ENABLE_SUPABASE_CRM: Master switch separating Stage 1 Demo Mode ("false")
# from Stage 2B Connected Mode ("true"). MUST remain "false" by default so Demo Mode
# stays active unless explicitly enabled in a local `.env` for dev testing.
VITE_ENABLE_SUPABASE_CRM="false"

# Browser-safe Supabase project URL and publishable/anon key ONLY.
# Copy this file to `.env` and fill VITE_SUPABASE_PUBLISHABLE_KEY locally when testing
# Connected Dev Mode against the disposable dev project (`bkidngfzsubmyunacnju`).
# NEVER put sb_secret_*, service_role JWTs, or database passwords in VITE_* vars.
VITE_SUPABASE_URL="https://bkidngfzsubmyunacnju.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

